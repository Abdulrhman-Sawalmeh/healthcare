# AI assistant provider:
# auto = OpenRouter if OPENROUTER_API_KEY exists, then Gemini, then local fallback.
# openrouter = use OpenRouter free/OpenAI-compatible API.
# gemini = use Gemini.
# local = no external API, deterministic local fallback only.
AI_PROVIDER="auto"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_APP_NAME="Healthcare Graduation Project"
OPENROUTER_APP_URL="http://localhost:5175"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# The API also accepts GOOGLE_GENERATIVE_AI_API_KEY or GOOGLE_API_KEY if you prefer Google naming.

